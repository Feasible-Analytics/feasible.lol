{{/*
  home.json.json
  A lightweight index of every indexable page at /index.json.

  Titles and descriptions only. Including page bodies made it 220 KB, and
  nothing on the site searches full text — the help page filters its own
  rendered list in place, which needs no index at all.

  Created: 2026-09-03
  Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
*/}}
{{- $records := slice -}}
{{- range site.RegularPages -}}
  {{- if not (or .Params.noindex .Params.private) -}}
    {{- $records = $records | append (dict
      "title" .Title
      "url" .RelPermalink
      "summary" (or .Params.description .Summary | plainify | truncate 180)
      "section" (or .Params.category .Section)
    ) -}}
  {{- end -}}
{{- end -}}
{{- $records | jsonify -}}
