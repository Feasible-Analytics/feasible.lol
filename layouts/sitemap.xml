{{/*
  sitemap.xml
  Hugo's default sitemap lists every page, including ones the head partial marks
  noindex. Telling a search engine about a page and telling it not to index the
  page is a contradiction, so those are filtered out here.

  Created: 2026-09-03
  Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
*/}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Pages }}
    {{- if not (or .Params.noindex .Params.private) }}
      <url>
        <loc>{{ .Permalink }}</loc>
        {{- if not .Lastmod.IsZero }}
          <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
        {{- end }}
        {{- with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
        {{- if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
      </url>
    {{- end }}
  {{- end }}
</urlset>
